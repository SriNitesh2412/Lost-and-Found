rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed(){ return request.auth != null; }
    function admin(){ return signed() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{u} {
      allow read: if signed() && (request.auth.uid == u || admin());
      allow create: if request.auth.uid == u && request.resource.data.role == 'student';
      allow update: if (request.auth.uid == u && request.resource.data.role == resource.data.role) || admin();
      allow delete: if admin();
    }
    match /items/{i} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signed() && (resource.data.ownerId == request.auth.uid || admin());
      allow delete: if signed() && (resource.data.ownerId == request.auth.uid || admin());
      match /private/{d} {
        allow read, write: if signed() && (get(/databases/$(db)/documents/items/$(i)).data.ownerId == request.auth.uid || admin());
      }
    }
    match /claims/{c} {
      allow create: if signed() && request.resource.data.claimantId == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if signed() && (resource.data.claimantId == request.auth.uid || resource.data.ownerId == request.auth.uid || admin());
      allow update: if signed() && (resource.data.ownerId == request.auth.uid || admin());
      allow delete: if admin();
    }
    match /messages/{m} {
      allow create: if signed() && request.resource.data.from == request.auth.uid && request.auth.uid in request.resource.data.participants;
      allow read: if signed() && request.auth.uid in resource.data.participants;
    }
    match /notifications/{n} {
      allow create: if signed();
      allow read, update, delete: if signed() && resource.data.uid == request.auth.uid;
    }
    match /reports/{r} {
      allow create: if signed() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if admin();
    }
    match /categories/{c} { allow read: if signed(); allow write: if admin(); }
  }
}
